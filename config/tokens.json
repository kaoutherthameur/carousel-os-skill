{
  "version": 1,
  "brand": {
    "name": "Carousel OS",
    "account": "@yourhandle",
    "wordmark_lines": ["CAROUSEL", "OS"]
  },
  "canvas": {
    "width": 1080,
    "height": 1350,
    "aspect_ratio": "4:5",
    "safe_area": {"left": 60, "right": 60, "top": 50, "bottom": 70},
    "thumbnail": {"width": 320, "height": 400}
  },
  "colors": {
    "cloud_white": "#F3F7FF",
    "midnight_navy": "#071A36",
    "coral_punch": "#FF5C35",
    "sky_signal": "#48C6EF",
    "mist_blue": "#DCEBFA",
    "slate_blue": "#60738D",
    "ink_black": "#101820"
  },
  "fonts": {
    "latin_regular": [],
    "latin_bold": [],
    "arabic_regular": [],
    "arabic_bold": []
  },
  "cover": {
    "cta_allowed": false,
    "candidate_count": 3,
    "title_method": "deterministic-overlay"
  },
  "carousel": {
    "default_slides": 7,
    "min_slides": 5,
    "max_slides": 9,
    "cta_slide": "last-only",
    "slide_2_role": "second-chance-hook"
  }
}
